<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.abesho.anime-automation.auto-pilot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__AUTOMATION_DIR__/run.sh</string>
    <string>auto_pilot.py</string>
  </array>

  <!-- 毎朝 8:30 に実行（daily_briefing の後）。 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__AUTOMATION_DIR__/logs/launchd-auto-pilot.out</string>
  <key>StandardErrorPath</key>
  <string>__AUTOMATION_DIR__/logs/launchd-auto-pilot.err</string>
</dict>
</plist>
