# automation/.env のテンプレート。値を埋めて automation/.env として保存する。
# このファイル(.env)は .gitignore 済み。GitHub には push されない。

# --- 朝のブリーフィング (daily_briefing.py) ---
# Notion インテグレーションのトークン（https://www.notion.so/my-integrations）
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# タスク管理用データベースの ID（DB の URL の 32 桁の英数字）
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Discord 通知（両スクリプト共通） ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxx/xxxxxxxxxx

# --- X 投稿テキストの連携先（auto_pilot.py） ---
# MAKE_WEBHOOK_URL を設定すると Make.com 経由で連携。未設定なら DISCORD_WEBHOOK_URL に直接送信。
MAKE_WEBHOOK_URL=

# --- 要約用（任意・未設定なら要約をスキップ） ---
# anime-antenna-tools/.env の OPENAI_API_KEY を自動利用するため通常は空でよい
OPENAI_API_KEY=

# --- 動作パラメータ（任意・既定値あり） ---
# auto_pilot が一度に巡回する note 作品数
AUTO_PILOT_MAX_WORKS=40
# true にすると git push を行わない（テスト用）
AUTO_PILOT_NO_PUSH=false
